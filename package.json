{
  "name": "ethereum-proof-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "wrangler dev --config dist/ethereum_proof_atlas/wrangler.json --local --ip 127.0.0.1 --port 4173",
    "deploy": "npm run verify && wrangler deploy --config dist/ethereum_proof_atlas/wrangler.json",
    "typecheck": "tsc --noEmit",
    "data:validate": "tsx scripts/validate-data.ts",
    "proofs:check": "tsx scripts/proof-updates.ts check",
    "proofs:accept": "tsx scripts/proof-updates.ts accept",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run data:validate && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "hono": "4.13.16",
    "json-canonicalize": "3.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "proper-lockfile": "4.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "^4.156.1"
  }
}
